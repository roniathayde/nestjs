
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id     String @id @default(uuid())
  name    String
  email     String @Unique
  password  String

  @@map('users')
}

model Question {
  id     String @id @default(uuid())
  title String
  slug String @unique
  content String
  
  createdAt DateTime @default(now()) @@map('created_at')
  updatedAt DateTime? @updatedAt @@map('updated_at')

  author User

  @@map('questions')
}